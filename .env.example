# ============================================================
# BARESKRIM REKRUTMEN - Environment Example
# Salin file ini menjadi ".env" lalu isi nilainya.
# JANGAN SEKALI-KALI commit file .env ke repository!
# ============================================================

# --- Database (PostgreSQL) ---
# Isi dengan connection string Supabase/Neon/Railway Anda.
# Format: postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@db.HOST.supabase.co:5432/postgres?sslmode=require"

# --- Auth ---
# Ganti dengan string acak panjang (min 32 karakter).
# Bisa dibuat dengan: openssl rand -base64 32
JWT_SECRET="GANTI_DENGAN_STRING_ACAK_PANJANG_SEPERTI_INI_jangan_dibagikan_kemana_mana"

# --- Discord Webhook (channel pusdik milik instruktur) ---
# Buka channel -> Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/XXXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# Nama bot yang tampil pada laporan Discord
DISCORD_BOT_NAME="Sistem Rekrutmen Bareskrim Polri"

# --- Discord: Cross-check manual di panel admin ---
# ID channel sumber putusan/blacklist (opsional, untuk tombol "Buka Channel").
# Tanpa bot Discord, isi channel TIDAK bisa dibaca otomatis - data diisi lewat panel admin.
# DISCORD_GUILD_ID: klik kanan nama server -> Copy Server ID. Dipakai untuk link "Buka Channel".
DISCORD_GUILD_ID=""
DISCORD_PUTUSAN_CHANNEL_ID=""
DISCORD_BLACKLIST_POLRI_CHANNEL_ID=""
DISCORD_BLACKLIST_PENDIDIKAN_CHANNEL_ID=""
# --- Roblox: Grup Wajib ---
# ID grup "[RI] Republic Indonesia" -> buka grup di Roblox, lihat URL /groups/{id}/...
REQUIRED_GROUP_ID="11902409"
REQUIRED_GROUP_NAME="[RI] Republic Indonesia"

# --- Roblox: Grup Kepolisian (untuk menampilkan pangkat/rank casis) ---
POLICE_GROUP_ID="14460225"
POLICE_GROUP_NAME="Kepolisian"

# --- Roblox: Pangkat Minimal ---
# Casis dengan urutan pangkat (Roblox role rank) DI BAWAH nilai ini tidak bisa
# mengikuti ujian. 225 = "[ENLISTED] Bhayangkara Kepala" di grup Kepolisian.
MIN_POLICE_RANK="225"
MIN_POLICE_RANK_NAME="Bhayangkara Kepala"

# --- Roblox: Grup Matra Terlarang (dipisah koma) ---
# Jika casis terdaftar di salah satu grup ini, akses ujian DITOLAK.
BANNED_GROUP_IDS="367050757,34766643"
BANNED_GROUP_NAMES="TNI AD,TNI AL"

# --- Aturan Ujian ---
KKM=75
MCQ_COUNT=15
ESSAY_COUNT=5
MCQ_POINTS=4
ESSAY_POINTS=8
EXAM_DURATION_MINUTES=45

# --- Keamanan Admin ---
# Kunci rahasia yang wajib dikirim sebagai header `x-admin-key` saat membuka
# periode baru / mengelola bank soal dari halaman /admin.
ADMIN_KEY="DiklatReserse"
