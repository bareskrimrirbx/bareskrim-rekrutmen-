# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:bareskrim2026@db.hbucvppcbdotnhlzwasi.supabase.co:5432/postgres"

# --- Auth ---
# Ganti dengan string acak panjang (min 32 karakter).
# Bisa dibuat dengan: openssl rand -base64 32
JWT_SECRET="GANTI_DENGAN_STRING_ACAK_PANJANG_SEPERTI_INI_jangan_dibagikan_kemana_mana"

# --- Discord Webhook (channel pusdik milik instruktur) ---
# Buka channel -> Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/1532464325464166580/wVU0ZSS6fT2_e9KltBVaqnu0UwSafennOJ8Zu8DUi557M9AGIY20-XrkW3I1FFYt9dke"
# Nama bot yang tampil pada laporan Discord
DISCORD_BOT_NAME="Sistem Rekrutmen Bareskrim Polri"

# --- Roblox: Grup Wajib ---
# ID grup "[RI] Republic Indonesia" -> buka grup di Roblox, lihat URL /groups/{id}/...
REQUIRED_GROUP_ID="11902409"
REQUIRED_GROUP_NAME="[RI] Republic Indonesia"

# --- Roblox: Grup Kepolisian (untuk menampilkan pangkat/rank casis) ---
POLICE_GROUP_ID="14460225"
POLICE_GROUP_NAME="Kepolisian"

# --- Roblox: Grup Matra Terlarang (dipisah koma) ---
# Jika casis terdaftar di salah satu grup ini, akses ujian DITOLAK.
BANNED_GROUP_IDS="367050757,34766643"
BANNED_GROUP_NAMES="TNI AD,TNI AL"

# --- Aturan Ujian ---
KKM=75
MCQ_COUNT=15
ESSAY_COUNT=5
MCQ_POINTS=4
ESSAY_POINTS=8
EXAM_DURATION_MINUTES=30

# --- Keamanan Admin ---
# Kunci rahasia yang wajib dikirim sebagai header `x-admin-key` saat membuka
# periode baru / mengelola bank soal dari halaman /admin.
ADMIN_KEY="DiklatReserse"
